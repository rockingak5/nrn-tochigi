NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nrn_tochigi_dev
DB_USER=root
DB_PASSWORD=

# Comma-separated list of origins allowed to call this API with credentials
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://127.0.0.1:3000,http://127.0.0.1:4000

# Session cookie signing secret
SESSION_SECRET=change-me

# Used only by `pnpm db:seed` to create the initial admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
