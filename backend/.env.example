# development or production. In production this also makes session cookies
# "secure", which requires the app to be served over HTTPS.
NODE_ENV=development
PORT=5000

# In production, use the DB host/port/name/user/password issued by your host
# (e.g. GoDaddy's managed MySQL for the app) — do not reuse local dev values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nrn_tochigi_dev
DB_USER=root
DB_PASSWORD=

# Comma-separated list of origins allowed to call this API with credentials.
# In production, list the real public site + admin panel domains (https://...),
# not localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://127.0.0.1:3000,http://127.0.0.1:4000

# Session cookie signing secret. Generate a fresh random value per environment
# (e.g. `openssl rand -hex 32`) — never reuse the same secret across dev/prod.
SESSION_SECRET=change-me

# Used only by `pnpm db:seed` to create the initial admin login. Use a strong,
# unique password in production — this is the real admin panel login once seeded.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Required in every environment — image uploads (POST /api/admin/uploads) go
# straight to S3, there is no local-disk fallback. Credentials are read from
# the standard AWS SDK provider chain (these env vars); use an IAM user/role
# scoped to PutObject on this one bucket only, never a broad/root key.
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# Optional. Uploaded file URLs default to the bucket's own public
# virtual-hosted-style URL (https://<bucket>.s3.<region>.amazonaws.com/...).
# Set this to switch to a CDN (e.g. a CloudFront domain) in front of the
# bucket later without any code change or re-uploading existing files.
AWS_S3_PUBLIC_BASE_URL=
